# Server
PORT=5000
NODE_ENV=development

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=committee_management
DB_USER=root
DB_PASSWORD=your_mysql_password

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Society/Club details (used on the QR payment page)
CLUB_NAME=Sample Society Committee
CLUB_UPI_ID=clubname@upi

# Admin seed account (used by npm run seed)
SEED_ADMIN_NAME=Society Admin
SEED_ADMIN_EMAIL=admin@committee.local
SEED_ADMIN_PASSWORD=Admin@123
